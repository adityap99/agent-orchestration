# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model assignments (OpenRouter model IDs)
MODEL_INTENT=anthropic/claude-3-haiku
MODEL_PLANNER=anthropic/claude-3.7-sonnet
MODEL_EXECUTOR=anthropic/claude-3-haiku
MODEL_CRITIC=anthropic/claude-3.7-sonnet
MODEL_SYNTHESIS=anthropic/claude-sonnet-4.6
MODEL_VERIFIER=anthropic/claude-3-haiku

# Budget per run (USD)
RUN_BUDGET_USD=1.00

# Max search iterations before force-draft
MAX_ITERATIONS=5

# Confidence threshold to proceed to draft
CONFIDENCE_THRESHOLD=0.65
